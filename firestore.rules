rules_version = '2';

// Puran Haat — production Firestore rules
//
// Design principles:
//   1. Deny by default. Only the collections below are reachable.
//   2. Public marketplace reads, authenticated + verified writes.
//   3. Ownership is proven against the auth UID, never a client-supplied flag.
//   4. Writes are shape-checked so clients cannot smuggle bad data or spoof stats.
//   5. Chat/proposal documents are readable only by their two participants.
//
// Deployment: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------
    // Helpers
    // ---------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isParticipant(resourceData) {
      return isSignedIn()
        && resourceData.participants is list
        && request.auth.uid in resourceData.participants;
    }

    function isNonEmptyString(value, maxLength) {
      return value is string && value.size() > 0 && value.size() <= maxLength;
    }

    function isOptionalString(value, maxLength) {
      return value == null || (value is string && value.size() <= maxLength);
    }

    function isOptionalNumber(value) {
      return value == null || value is number;
    }

    function isOneOf(value, allowed) {
      return value in allowed;
    }

    // ---------------------------------------------------------------------
    // items — public marketplace listings
    // ---------------------------------------------------------------------
    match /items/{itemId} {
      // The feed is public so signed-out visitors can browse.
      allow read: if true;

      allow create: if isVerified()
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.user is map
        && request.resource.data.user.id == request.auth.uid
        && isNonEmptyString(request.resource.data.title, 120)
        && isOptionalString(request.resource.data.get('description', null), 2000)
        && isNonEmptyString(request.resource.data.category_id, 40)
        && isOneOf(request.resource.data.condition, ['brand_new', 'like_new', 'gently_used', 'fair'])
        && isOneOf(request.resource.data.trade_mode, ['trade', 'free', 'auction'])
        && isOneOf(request.resource.data.eco_impact_rating, ['High', 'Med', 'Low'])
        && request.resource.data.co2_saved_kg is number
        && request.resource.data.co2_saved_kg >= 0
        && request.resource.data.images is list
        && request.resource.data.images.size() <= 5
        && isNonEmptyString(request.resource.data.location_name, 120)
        && isOptionalNumber(request.resource.data.get('distance_km', null))
        && isNonEmptyString(request.resource.data.created_at, 40);

      allow update: if isVerified()
        && resource.data.user_id == request.auth.uid
        // Ownership and creation time are immutable, even for the owner.
        && request.resource.data.user_id == resource.data.user_id
        && request.resource.data.user == resource.data.user
        && request.resource.data.created_at == resource.data.created_at
        && isNonEmptyString(request.resource.data.title, 120)
        && isOptionalString(request.resource.data.get('description', null), 2000)
        && request.resource.data.images is list
        && request.resource.data.images.size() <= 5;

      allow delete: if isVerified()
        && resource.data.user_id == request.auth.uid;
    }

    // ---------------------------------------------------------------------
    // users — private profile documents keyed by auth UID
    // ---------------------------------------------------------------------
    match /users/{userId} {
      allow read: if isSignedIn();

      allow create: if isSelf(userId)
        && isNonEmptyString(request.resource.data.full_name, 80)
        && isOptionalString(request.resource.data.get('username', null), 30)
        && isOptionalString(request.resource.data.get('bio', null), 160)
        && isOptionalString(request.resource.data.get('district', null), 80)
        && isOptionalString(request.resource.data.get('avatar_url', null), 2048)
        // The badge must mirror the real email-verification claim.
        && request.resource.data.get('is_verified', false) == request.auth.token.email_verified
        // New accounts start with a clean scoreboard.
        && request.resource.data.get('eco_points', 0) == 0
        && request.resource.data.get('trade_count', 0) == 0
        && request.resource.data.get('rating', 0) == 0;

      allow update: if isSelf(userId)
        && isNonEmptyString(request.resource.data.full_name, 80)
        && isOptionalString(request.resource.data.get('username', null), 30)
        && isOptionalString(request.resource.data.get('bio', null), 160)
        && isOptionalString(request.resource.data.get('district', null), 80)
        && isOptionalString(request.resource.data.get('avatar_url', null), 2048)
        && request.resource.data.get('is_verified', false) == request.auth.token.email_verified
        // Ratings are server-owned. Trade/eco counters may only move +1 / +50
        // so a client cannot award itself arbitrary points.
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['rating'])
            || request.resource.data.rating == resource.data.rating)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['trade_count'])
            || request.resource.data.trade_count == resource.data.trade_count + 1)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['eco_points'])
            || request.resource.data.eco_points == resource.data.eco_points + 50);

      allow delete: if isSelf(userId);
    }

    // ---------------------------------------------------------------------
    // favorites — one document per (user, item)
    // ---------------------------------------------------------------------
    match /favorites/{favoriteId} {
      allow read: if isSignedIn()
        && resource.data.user_id == request.auth.uid;

      allow create: if isSignedIn()
        && request.resource.data.user_id == request.auth.uid
        && isNonEmptyString(request.resource.data.item_id, 128)
        && favoriteId == request.auth.uid + '_' + request.resource.data.item_id
        && request.resource.data.created_at is number;

      allow delete: if isSignedIn()
        && resource.data.user_id == request.auth.uid;
    }

    // ---------------------------------------------------------------------
    // conversations — two participants per thread
    // ---------------------------------------------------------------------
    match /conversations/{conversationId} {
      allow read: if isSignedIn()
        && request.auth.uid in resource.data.participants;

      allow create: if isVerified()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.profiles is map
        && request.resource.data.profiles.keys().hasAll(request.resource.data.participants)
        && isNonEmptyString(request.resource.data.itemId, 128)
        && isNonEmptyString(request.resource.data.itemTitle, 120)
        && isOptionalString(request.resource.data.get('itemImage', null), 2048)
        && isNonEmptyString(request.resource.data.lastMessage, 1000)
        && request.resource.data.lastMessageAt is number
        && request.resource.data.unread is map
        && isOneOf(request.resource.data.status, ['pending', 'accepted', 'declined'])
        && isOptionalString(request.resource.data.get('proposalId', null), 128)
        && request.resource.data.created_at is number;

      allow update: if isVerified()
        && request.auth.uid in resource.data.participants
        // The participant pair, profile snapshots, item and creation time
        // can never change.
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.profiles == resource.data.profiles
        && request.resource.data.itemId == resource.data.itemId
        && request.resource.data.itemTitle == resource.data.itemTitle
        && request.resource.data.get('itemImage', '') == resource.data.get('itemImage', '')
        && request.resource.data.created_at == resource.data.created_at
        // A proposal may be attached once, then stays fixed.
        && (request.resource.data.get('proposalId', null) == resource.data.get('proposalId', null)
            || resource.data.get('proposalId', null) == null)
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() <= 1000
        && request.resource.data.lastMessageAt is number
        && request.resource.data.unread is map
        // Only valid status transitions are allowed.
        && (request.resource.data.status == resource.data.status
            || (resource.data.status == 'pending'
                && request.resource.data.status in ['accepted', 'declined']));

      // Chat history is kept; conversations are never deleted by clients.
      allow delete: if false;
    }

    // ---------------------------------------------------------------------
    // messages — immutable chat log, participant-only
    // ---------------------------------------------------------------------
    match /conversations/{conversationId}/messages/{messageId} {
      function conversation() {
        return get(/databases/$(database)/documents/conversations/$(conversationId)).data;
      }

      allow read: if isSignedIn()
        && conversation().participants is list
        && request.auth.uid in conversation().participants;

      allow create: if isVerified()
        && conversation().participants is list
        && request.auth.uid in conversation().participants
        && request.resource.data.sender_id == request.auth.uid
        && isNonEmptyString(request.resource.data.text, 1000)
        && request.resource.data.created_at is number;

      // Messages are append-only. Edit/delete would break the trade record.
      allow update, delete: if false;
    }

    // ---------------------------------------------------------------------
    // proposals — two participants, explicit status lifecycle
    // ---------------------------------------------------------------------
    match /proposals/{proposalId} {
      allow read: if isSignedIn()
        && request.auth.uid in resource.data.participants;

      allow create: if isVerified()
        && request.resource.data.proposer_id == request.auth.uid
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.receiver_id in request.resource.data.participants
        && request.resource.data.receiver_id != request.auth.uid
        && request.resource.data.status == 'pending'
        && isNonEmptyString(request.resource.data.requested_item_id, 128)
        && isOptionalString(request.resource.data.get('offered_item_id', null), 128)
        && request.resource.data.cash_adjustment is number
        && request.resource.data.cash_adjustment >= 0
        && isOptionalString(request.resource.data.get('note', null), 1000)
        && isNonEmptyString(request.resource.data.conversation_id, 128)
        && request.resource.data.created_at is number;

      allow update: if isVerified()
        && request.auth.uid in resource.data.participants
        // Trade participants, items and creation time are immutable.
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.proposer_id == resource.data.proposer_id
        && request.resource.data.receiver_id == resource.data.receiver_id
        && request.resource.data.requested_item_id == resource.data.requested_item_id
        && request.resource.data.get('offered_item_id', null) == resource.data.get('offered_item_id', null)
        && request.resource.data.created_at == resource.data.created_at
        // Allowed lifecycle: pending -> accepted|declined|countered,
        // countered -> accepted|declined, accepted -> completed.
        && (request.resource.data.status == resource.data.status
            || (resource.data.status == 'pending'
                && request.resource.data.status in ['accepted', 'declined', 'countered'])
            || (resource.data.status == 'countered'
                && request.resource.data.status in ['accepted', 'declined'])
            || (resource.data.status == 'accepted'
                && request.resource.data.status == 'completed'));

      allow delete: if isVerified()
        && resource.data.proposer_id == request.auth.uid
        && resource.data.status == 'pending';
    }

    // Everything not matched above is denied.
  }
}
