rules_version = '2';

// Puran Haat — production Firestore rules
//
// Design principles:
//   1. Deny by default. Only the collections below are reachable.
//   2. Public marketplace reads, authenticated + verified writes.
//   3. Ownership is proven against the auth UID, never a client-supplied flag.
//   4. Writes are shape-checked so clients cannot smuggle bad data or spoof stats.
//   5. Chat/proposal documents are readable only by their two participants.
//
// Deployment: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------
    // Helpers
    // ---------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    // `Map.get` with a default keeps this safe for tokens that carry no
    // email_verified claim at all (anonymous guests, some providers).
    function isVerified() {
      return isSignedIn() && request.auth.token.get('email_verified', false) == true;
    }

    // Guest sessions use Firebase Anonymous Auth, so a visitor can browse and
    // chat before creating an account. Detected from the token's provider.
    function isAnonymous() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    // Chat is open to guests as well as verified traders. Creating listings,
    // sending proposals and admin actions still require a verified email.
    // Guests are checked first so an anonymous token never touches the
    // email-verification claim.
    function canChat() {
      return isAnonymous() || isVerified();
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isNonEmptyString(value, maxLength) {
      return value is string && value.size() > 0 && value.size() <= maxLength;
    }

    function isOptionalString(value, maxLength) {
      return value == null || (value is string && value.size() <= maxLength);
    }

    function isOptionalNumber(value) {
      return value == null || value is number;
    }

    // Optional coordinate pair. Both keys must be absent, or both present as
    // numbers inside the legal WGS-84 range.
    function isOptionalCoordinate(value, lower, upper) {
      return value == null || (value is number && value >= lower && value <= upper);
    }

    function hasValidCoordinates() {
      return isOptionalCoordinate(request.resource.data.get('latitude', null), -90, 90)
        && isOptionalCoordinate(request.resource.data.get('longitude', null), -180, 180)
        // Never store half a pin: latitude and longitude travel together.
        && (request.resource.data.get('latitude', null) == null)
             == (request.resource.data.get('longitude', null) == null);
    }

    function isOneOf(value, allowed) {
      return value in allowed;
    }

    // ---------------------------------------------------------------------
    // Admin roster
    //
    // Admins are NOT a custom claim, because claims need the Admin SDK to
    // mint. Instead membership is one document per admin UID under
    // `admins/{uid}`. Only the Firebase console (which bypasses rules) or an
    // existing super admin using the Admin SDK can add a row, so a client can
    // never promote itself. See admin-web/README.md for the bootstrap step.
    // ---------------------------------------------------------------------
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{adminId} {
      // Signed-in clients may read their own row so the app can show the
      // admin entry point; nobody writes from the client.
      allow read: if isSelf(adminId);
      allow write: if false;
    }

    // ---------------------------------------------------------------------
    // presence — live online / last-seen flag, one row per trader
    //
    // Presence is semi-public on purpose: any signed-in trader may read it so
    // a chat can show "Online" / "Last seen 5m ago". Only the owner may write
    // their own row, so nobody can spoof someone else being online.
    // ---------------------------------------------------------------------
    match /presence/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSelf(userId)
        && request.resource.data.online is bool
        && request.resource.data.last_seen is number;
      allow delete: if isSelf(userId);
    }

    // ---------------------------------------------------------------------
    // pushTokens — private device registrations, one doc per trader
    //
    // Kept out of the profile so another signed-in trader can never read
    // someone else's device tokens. Only the owner reads or writes their row;
    // the push Worker uses the Admin SDK, which bypasses these rules.
    // ---------------------------------------------------------------------
    match /pushTokens/{userId} {
      allow read: if isSelf(userId);
      allow create, update: if isSelf(userId)
        && request.resource.data.tokens is list
        && request.resource.data.tokens.size() <= 10
        && request.resource.data.updated_at is number;
      allow delete: if isSelf(userId);
    }

    // ---------------------------------------------------------------------
    // items — public marketplace listings
    // ---------------------------------------------------------------------
    match /items/{itemId} {
      // The feed is public so signed-out visitors can browse.
      allow read: if true;

      allow create: if isVerified()
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.user is map
        && request.resource.data.user.id == request.auth.uid
        // The seller badge is derived from the auth claim, not the client.
        && request.resource.data.user.get('is_verified', false) == request.auth.token.get('email_verified', false)
        && isNonEmptyString(request.resource.data.user.full_name, 80)
        && request.resource.data.user.get('rating', 0) is number
        && request.resource.data.user.get('trade_count', 0) is int
        && request.resource.data.user.get('eco_points', 0) is int
        && isNonEmptyString(request.resource.data.title, 120)
        && isOptionalString(request.resource.data.get('description', null), 2000)
        && isNonEmptyString(request.resource.data.category_id, 40)
        && isOneOf(request.resource.data.condition, ['brand_new', 'like_new', 'gently_used', 'fair'])
        && isOneOf(request.resource.data.trade_mode, ['trade', 'free', 'auction'])
        && isOneOf(request.resource.data.eco_impact_rating, ['High', 'Med', 'Low'])
        && request.resource.data.co2_saved_kg is number
        && request.resource.data.co2_saved_kg >= 0
        && request.resource.data.images is list
        && request.resource.data.images.size() <= 5
        && isNonEmptyString(request.resource.data.location_name, 120)
        && isOptionalNumber(request.resource.data.get('distance_km', null))
        && hasValidCoordinates()
        && isNonEmptyString(request.resource.data.created_at, 40);

      allow update: if isVerified()
        && resource.data.user_id == request.auth.uid
        // Ownership and creation time are immutable, even for the owner.
        && request.resource.data.user_id == resource.data.user_id
        && request.resource.data.user == resource.data.user
        && request.resource.data.created_at == resource.data.created_at
        && isNonEmptyString(request.resource.data.title, 120)
        && isOptionalString(request.resource.data.get('description', null), 2000)
        && isNonEmptyString(request.resource.data.category_id, 40)
        && isOneOf(request.resource.data.condition, ['brand_new', 'like_new', 'gently_used', 'fair'])
        && isOneOf(request.resource.data.trade_mode, ['trade', 'free', 'auction'])
        && isOneOf(request.resource.data.eco_impact_rating, ['High', 'Med', 'Low'])
        && request.resource.data.co2_saved_kg is number
        && request.resource.data.co2_saved_kg >= 0
        && isNonEmptyString(request.resource.data.location_name, 120)
        && isOptionalNumber(request.resource.data.get('distance_km', null))
        && hasValidCoordinates()
        && request.resource.data.images is list
        && request.resource.data.images.size() <= 5;

      allow delete: if isVerified()
        && resource.data.user_id == request.auth.uid;
    }

    // ---------------------------------------------------------------------
    // users — private profile documents keyed by auth UID
    // ---------------------------------------------------------------------
    match /users/{userId} {
      allow read: if isSignedIn();

      allow create: if isSelf(userId)
        && isNonEmptyString(request.resource.data.full_name, 80)
        && isOptionalString(request.resource.data.get('username', null), 30)
        && isOptionalString(request.resource.data.get('bio', null), 160)
        && isOptionalString(request.resource.data.get('district', null), 80)
        && isOptionalString(request.resource.data.get('avatar_url', null), 2048)
        && hasValidCoordinates()
        // The badge must mirror the real email-verification claim.
        && request.resource.data.get('is_verified', false) == request.auth.token.get('email_verified', false)
        // New accounts start with a clean scoreboard.
        && request.resource.data.get('eco_points', 0) == 0
        && request.resource.data.get('trade_count', 0) == 0
        && request.resource.data.get('rating', 0) == 0;

      // Demo profiles only: the portal's "Load demo data" button needs somewhere
      // to hang the sample traders, and `demo-` ids can never collide with a
      // real auth UID. Admins still cannot create arbitrary profiles.
      allow create: if isAdmin()
        && userId.matches('demo-.*')
        && isNonEmptyString(request.resource.data.full_name, 80);

      allow update: if isSelf(userId)
        && isNonEmptyString(request.resource.data.full_name, 80)
        && isOptionalString(request.resource.data.get('username', null), 30)
        && isOptionalString(request.resource.data.get('bio', null), 160)
        && isOptionalString(request.resource.data.get('district', null), 80)
        && isOptionalString(request.resource.data.get('avatar_url', null), 2048)
        && hasValidCoordinates()
        && request.resource.data.get('is_verified', false) == request.auth.token.get('email_verified', false)
        // Ratings and counters are server-owned. Clients cannot inflate them.
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['rating'])
            || request.resource.data.rating == resource.data.rating)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['trade_count'])
            || request.resource.data.trade_count == resource.data.trade_count)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['eco_points'])
            || request.resource.data.eco_points == resource.data.eco_points);

      allow delete: if isSelf(userId);

      // Admins may only touch the moderation-owned fields, never identity,
      // stats or the email-verification mirror.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['moderation_status', 'suspended_until', 'admin_notes', 'trust_score', 'is_verified'])
        && isOneOf(
             request.resource.data.get('moderation_status', 'clear'),
             ['clear', 'flagged', 'suspended', 'banned']
           )
        && isOptionalNumber(request.resource.data.get('suspended_until', null))
        && isOptionalString(request.resource.data.get('admin_notes', null), 2000)
        && request.resource.data.get('trust_score', 0) is number
        && request.resource.data.get('trust_score', 0) >= 0
        && request.resource.data.get('trust_score', 0) <= 100;
    }

    // ---------------------------------------------------------------------
    // favorites — one document per (user, item)
    // ---------------------------------------------------------------------
    match /favorites/{favoriteId} {
      allow read: if isSignedIn()
        && resource.data.user_id == request.auth.uid;

      allow create: if isSignedIn()
        && request.resource.data.user_id == request.auth.uid
        && isNonEmptyString(request.resource.data.item_id, 128)
        && favoriteId == request.auth.uid + '_' + request.resource.data.item_id
        && request.resource.data.created_at is number;

      allow delete: if isSignedIn()
        && resource.data.user_id == request.auth.uid;
    }

    // ---------------------------------------------------------------------
    // conversations — two participants per thread
    // ---------------------------------------------------------------------
    match /conversations/{conversationId} {
      allow read: if isSignedIn()
        && request.auth.uid in resource.data.participants;

      allow create: if canChat()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.profiles is map
        && request.resource.data.profiles.keys().hasAll(request.resource.data.participants)
        && isNonEmptyString(request.resource.data.itemId, 128)
        && isNonEmptyString(request.resource.data.itemTitle, 120)
        && isOptionalString(request.resource.data.get('itemImage', null), 2048)
        && isNonEmptyString(request.resource.data.lastMessage, 1000)
        && request.resource.data.lastMessageAt is number
        && request.resource.data.unread is map
        && isOneOf(request.resource.data.status, ['pending', 'accepted', 'declined'])
        && isOptionalString(request.resource.data.get('proposalId', null), 128)
        && isOptionalString(request.resource.data.get('proposer_id', null), 128)
        && isOptionalString(request.resource.data.get('receiver_id', null), 128)
        // When a proposal is attached, the creator must be its proposer and the
        // receiver must be the other participant.
        && (request.resource.data.get('proposalId', null) == null
            || (request.resource.data.get('proposer_id', '') == request.auth.uid
                && request.resource.data.get('receiver_id', '') in request.resource.data.participants
                && request.resource.data.get('receiver_id', '') != request.auth.uid))
        && request.resource.data.created_at is number;

      allow update: if canChat()
        && request.auth.uid in resource.data.participants
        // The participant pair, profile snapshots, item and creation time
        // can never change.
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.profiles == resource.data.profiles
        && request.resource.data.itemId == resource.data.itemId
        && request.resource.data.itemTitle == resource.data.itemTitle
        && request.resource.data.get('itemImage', '') == resource.data.get('itemImage', '')
        && request.resource.data.created_at == resource.data.created_at
        // Proposal pointers are immutable, except when attaching the first
        // proposal or replacing a declined one with a fresh proposal.
        && (request.resource.data.get('proposalId', null) == resource.data.get('proposalId', null)
            || (request.auth.uid == request.resource.data.get('proposer_id', '')
                && request.resource.data.get('receiver_id', '') in request.resource.data.participants
                && request.resource.data.get('receiver_id', '') != request.auth.uid
                && request.resource.data.status == 'pending'
                && (resource.data.get('proposalId', null) == null
                    || resource.data.status == 'declined')))
        && (request.resource.data.get('proposer_id', null) == resource.data.get('proposer_id', null)
            || resource.data.get('proposer_id', null) == null)
        && (request.resource.data.get('receiver_id', null) == resource.data.get('receiver_id', null)
            || resource.data.get('receiver_id', null) == null)
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() <= 1000
        && request.resource.data.lastMessageAt is number
        && request.resource.data.unread is map
        // Ephemeral live-chat signals.
        //  * typing — a heartbeat timestamp, written while a participant types.
        //  * reads  — the timestamp a participant has read the thread up to, so
        //             the other side can show a per-message "Seen" receipt.
        // Each participant may only write their OWN key: the counterpart's entry
        // must stay untouched, so neither side can forge presence or a receipt.
        && request.resource.data.get('typing', {}) is map
        && request.resource.data.get('reads', {}) is map
        && resource.data.get('typing', {})
             .diff(request.resource.data.get('typing', {})).affectedKeys()
             .hasOnly([request.auth.uid])
        && resource.data.get('reads', {})
             .diff(request.resource.data.get('reads', {})).affectedKeys()
             .hasOnly([request.auth.uid])
        // Only the receiver can accept or decline. A declined thread can be
        // re-opened with a new proposal.
        && (request.resource.data.status == resource.data.status
            || (resource.data.status == 'pending'
                && request.resource.data.status in ['accepted', 'declined']
                && request.auth.uid == resource.data.get('receiver_id', ''))
            || (resource.data.status == 'declined'
                && request.resource.data.status == 'pending'));

      // Chat history is kept; conversations are never deleted by clients.
      allow delete: if false;
    }

    // ---------------------------------------------------------------------
    // messages — immutable chat log, participant-only
    // ---------------------------------------------------------------------
    match /conversations/{conversationId}/messages/{messageId} {
      function conversation() {
        return get(/databases/$(database)/documents/conversations/$(conversationId)).data;
      }

      allow read: if isSignedIn()
        && conversation().participants is list
        && request.auth.uid in conversation().participants;

      allow create: if canChat()
        && conversation().participants is list
        && request.auth.uid in conversation().participants
        && request.resource.data.sender_id == request.auth.uid
        && isNonEmptyString(request.resource.data.text, 1000)
        && request.resource.data.created_at is number;

      // Messages are append-only. Edit/delete would break the trade record.
      allow update, delete: if false;
    }

    // ---------------------------------------------------------------------
    // proposals — two participants, explicit status lifecycle
    // ---------------------------------------------------------------------
    match /proposals/{proposalId} {
      allow read: if isSignedIn()
        && request.auth.uid in resource.data.participants;

      allow create: if isVerified()
        && request.resource.data.proposer_id == request.auth.uid
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.receiver_id in request.resource.data.participants
        && request.resource.data.receiver_id != request.auth.uid
        && request.resource.data.status == 'pending'
        && isNonEmptyString(request.resource.data.requested_item_id, 128)
        && isOptionalString(request.resource.data.get('offered_item_id', null), 128)
        && request.resource.data.cash_adjustment is number
        && request.resource.data.cash_adjustment >= 0
        && isOptionalString(request.resource.data.get('note', null), 1000)
        && isNonEmptyString(request.resource.data.conversation_id, 128)
        && request.resource.data.created_at is number;

      allow update: if isVerified()
        && request.auth.uid in resource.data.participants
        // Trade participants, items and creation time are immutable.
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.proposer_id == resource.data.proposer_id
        && request.resource.data.receiver_id == resource.data.receiver_id
        && request.resource.data.requested_item_id == resource.data.requested_item_id
        && request.resource.data.get('offered_item_id', null) == resource.data.get('offered_item_id', null)
        && request.resource.data.created_at == resource.data.created_at
        // Allowed lifecycle: pending -> accepted|declined|countered,
        // countered -> accepted|declined, accepted -> completed. Only the
        // receiver can accept or decline a pending/countered proposal.
        && (request.resource.data.status == resource.data.status
            || (request.auth.uid == resource.data.receiver_id
                && ((resource.data.status == 'pending'
                        && request.resource.data.status in ['accepted', 'declined', 'countered'])
                    || (resource.data.status == 'countered'
                        && request.resource.data.status in ['accepted', 'declined'])))
            || (resource.data.status == 'accepted'
                && request.resource.data.status == 'completed'));

      allow delete: if isVerified()
        && resource.data.proposer_id == request.auth.uid
        && resource.data.status == 'pending';
    }

    // ---------------------------------------------------------------------
    // Admin portal collections
    //
    // Traders can file their own verification request and a report; only an
    // admin can read the queues or make decisions.
    // ---------------------------------------------------------------------
    match /verifications/{verificationId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.user_id == request.auth.uid);

      allow create: if isAdmin()
        || (isSignedIn()
            && request.resource.data.user_id == request.auth.uid
            && request.resource.data.status == 'pending'
            && isNonEmptyString(request.resource.data.full_name, 80)
            && isNonEmptyString(request.resource.data.document_type, 80)
            && request.resource.data.file_count is int
            && request.resource.data.risk_score is number
            && request.resource.data.submitted_at is number);

      allow update, delete: if isAdmin();
    }

    match /moderationReports/{reportId} {
      allow read: if isAdmin();

      allow create: if isAdmin()
        || (isVerified()
            && request.resource.data.reporter_id == request.auth.uid
            && isNonEmptyString(request.resource.data.user_id, 128)
            && isOneOf(request.resource.data.type, ['listing', 'message', 'account'])
            && isNonEmptyString(request.resource.data.title, 120)
            && isNonEmptyString(request.resource.data.detail, 2000)
            && isOneOf(request.resource.data.status, ['open', 'resolved'])
            && request.resource.data.created_at is number);

      allow update, delete: if isAdmin();
    }

    // Auctions are public so the community can browse them before signing in.
    match /auctions/{auctionId} {
      allow read: if true;
      allow create, update, delete: if isAdmin()
        && isNonEmptyString(request.resource.data.title, 120)
        && request.resource.data.starting_bid is number
        && request.resource.data.starting_bid >= 0
        && isOneOf(request.resource.data.status, ['scheduled', 'active', 'ended'])
        && request.resource.data.starts_at is number
        && request.resource.data.duration_hours is int;
    }

    match /rewardRules/{ruleId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin()
        && isNonEmptyString(request.resource.data.name, 80)
        && request.resource.data.multiplier is number
        && request.resource.data.multiplier >= 0;
    }

    match /badges/{badgeId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin()
        && isNonEmptyString(request.resource.data.name, 80)
        && isNonEmptyString(request.resource.data.description, 240);
    }

    match /rewardGrants/{grantId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.recipient_id == request.auth.uid);
      allow create: if isAdmin()
        && isNonEmptyString(request.resource.data.recipient_id, 128)
        && isNonEmptyString(request.resource.data.recipient_name, 80)
        && isNonEmptyString(request.resource.data.reward_type, 80)
        && isNonEmptyString(request.resource.data.reason, 240)
        && request.resource.data.created_at is number;
      allow update, delete: if isAdmin();
    }

    // Everything not matched above is denied.
  }
}
