{
  "expo": {
    "name": "puran-haat",
    "slug": "puran-haat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "puranhaat",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.puranhaat.app",
      "googleServicesFile": "./GoogleService-Info.plist",
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "package": "com.puranhaat.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#154212",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FDFAE7",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 168
        }
      ],
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Puran Haat uses your photos to add pictures to your listings.",
          "cameraPermission": "Puran Haat uses your camera to photograph items you want to trade."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Puran Haat uses your location to show items for trade near you and to save a pickup area on your listings."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#154212",
          "defaultChannel": "messages"
        }
      ],
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
