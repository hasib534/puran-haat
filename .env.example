# Copy this file to .env.local and fill in the values from:
# Firebase Console -> Project settings -> General -> Your apps -> Web app
EXPO_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-firebase-project-id.firebasestorage.app

# Firebase Console -> Authentication -> Sign-in method -> Google -> Web SDK configuration
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Native Google Sign-In uses GoogleService-Info.plist and google-services.json
# at the repo root; no native client IDs belong in this file.

# Image uploads (listing photos + avatars) use Cloudinary's unsigned uploads.
# Cloudinary Console -> Settings -> Upload -> Add upload preset -> Signing Mode: Unsigned
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your-unsigned-upload-preset
# Optional folder prefix inside your Cloudinary account (defaults to puran-haat)
EXPO_PUBLIC_CLOUDINARY_FOLDER=puran-haat

# Push notifications — deploy push-worker/ first (see its README).
# Leave the URL blank and the app simply skips sending pings.
EXPO_PUBLIC_PUSH_WORKER_URL=
# Optional: set an EAS project ID to register Expo push tokens instead of the
# native FCM/APNs token (requires an Expo account + `eas init`).
EXPO_PUBLIC_EAS_PROJECT_ID=
